# Optional local services. The browser/offline core needs none of these.
# Copy this file to .env, fill only the providers you want, then npm run companion.
# .env is ignored by Git. Never prefix these server keys with VITE_.

INTAKE_PORT=4317
INTAKE_OWNER_LABEL=Workspace owner
# Default data folder: ~/.intake-repair-station
# INTAKE_DATA_DIR=/absolute/private/path
# A random persistent access token is created automatically if this is omitted.
# INTAKE_ACCESS_TOKEN=use-a-random-secret-with-at-least-32-characters
INTAKE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Enable only if connecting the downloaded HTML opened as file://.
INTAKE_ALLOW_FILE_ORIGIN=0

# Configure a provider key AND a model available to that account.
# Comma-separated model IDs are an explicit UI allowlist (up to 12).
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# OpenAI-compatible services differ. This adapter uses chat/completions JSON mode.
COMPATIBLE_API_KEY=
COMPATIBLE_MODEL=
COMPATIBLE_BASE_URL=https://api.openai.com/v1

# Install/pull a local model separately. Disable cloud features in Ollama itself
# (OLLAMA_NO_CLOUD=1 in the Ollama server's environment) for local-only inference.
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Request/output limits, not a currency-denominated billing cap.
AI_DAILY_REQUESTS=50
AI_MINUTE_REQUESTS=6
AI_MAX_OUTPUT_TOKENS=1600
AI_TIMEOUT_MS=60000

# Optional explicit handoff-summary connector. Nothing sends automatically.
# Requires HTTPS. The URL and secret stay in the companion, never in session files.
HANDOFF_WEBHOOK_URL=
HANDOFF_WEBHOOK_LABEL=Handoff webhook
HANDOFF_WEBHOOK_SECRET=
