{
  "name": "intake-repair-station",
  "version": "0.2.0",
  "private": true,
  "description": "An open-source local data review workspace with reusable recipes, reviewed corrections, optional AI, and complete handoffs.",
  "type": "module",
  "license": "MIT",
  "author": "Mohsin Siddiqi",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/package-static.mjs && node scripts/build-offline-demo.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test --test-isolation=none src/lib/*.test.mjs tests/*.test.mjs",
    "test:unit": "node --test --test-isolation=none src/lib/*.test.mjs tests/*.test.mjs",
    "pretest:e2e": "node scripts/build-offline-demo.mjs",
    "test:e2e": "playwright test",
    "notices": "node scripts/third-party-notices.mjs",
    "demo:offline": "node scripts/build-offline-demo.mjs",
    "companion": "node --env-file-if-exists=.env server/start.mjs",
    "local": "node scripts/start-local.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.62.1",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.5"
  }
}
